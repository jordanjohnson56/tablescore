# Copy to .env and fill in. .env is git-ignored; never commit your token.
BGG_TOKEN=
BGG_USERNAME=Theef
# Anthropic API key for Claude rating predictions (console.anthropic.com). Leave
# empty to turn predictions off. CLAUDE_MODEL defaults to claude-opus-5-5; set
# claude-sonnet-5-5 for faster, cheaper predictions.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
# Port on the host. The container only listens on 127.0.0.1, so it is reachable
# from this machine and through `tailscale serve`, not from the rest of your LAN.
PORT=8080
BACKUP_KEEP=14
